# ─── Шаблон переменных окружения ──────────────────────────────────────
# Скопируйте в .env и подставьте реальные значения.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# Подключение к БД (asyncpg). В docker-compose host = postgres.
DATABASE_URL=postgresql+asyncpg://sppr:CHANGE_ME_DB_PASSWORD@postgres:5432/sppr

# Брокер/бэкенд Celery
REDIS_URL=redis://redis:6379/0

# Секрет для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Пароль суперпользователя Postgres (используется при первой инициализации тома).
# Должен совпадать с паролем в DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Разрешённые источники для CORS (через запятую).
#   dev  → http://localhost:3000 (дев-сервер Vite)
#   prod → адрес сайта (в проде фронт и /api на одном origin, см. SITE_ADDRESS)
CORS_ORIGINS=http://localhost:3000

# ─── Только для боевого запуска (docker-compose.prod.yml) ─────────────
# Адрес сайта для Caddy:
#   локальная репетиция  → :80                (HTTP на localhost)
#   на сервере с доменом → sppr.example.com   (Caddy сам выпустит HTTPS)
SITE_ADDRESS=:80
# Число воркеров gunicorn (по умолчанию 2)
WEB_CONCURRENCY=2
