# ─── Шаблон переменных окружения ──────────────────────────────────────
# Скопируйте в .env и подставьте реальные значения.
# Файл .env в репозиторий НЕ коммитится (см. .gitignore).

# Подключение к БД (asyncpg). В docker-compose host = postgres.
DATABASE_URL=postgresql+asyncpg://sppr:CHANGE_ME_DB_PASSWORD@postgres:5432/sppr

# Брокер/бэкенд Celery
REDIS_URL=redis://redis:6379/0

# Секрет для подписи JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Пароль суперпользователя Postgres (используется при первой инициализации тома).
# Должен совпадать с паролем в DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Разрешённые источники для CORS (через запятую). В проде — реальный домен.
# Для локальной разработки — адрес дев-сервера Vite.
CORS_ORIGINS=http://localhost:3000
